# 用法：复制这个文件为 .env，然后把值填上
#     copy .env.example .env

# ---------------- 数据库 ----------------
db_host=localhost
db_port=3306
db_user=root
db_password=改成你自己的密码
db_name=ecom_app

# debug=true 会打印 SQL、异常带 traceback；上线必须改 false
debug=true

